generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String               @id @default(cuid())
  email           String               @unique
  passwordHash    String?
  name            String
  gender          String?
  age             Int?
  photoUrl        String?
  defaultLocation String?
  defaultLat      Float?
  defaultLng      Float?
  nationality     String?              // ISO 3166-1 alpha-3, optional
  locale          String               @default("EN")
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  interestProfile InterestProfile?
  passwordResets  PasswordResetToken[]
  planSession     PlanSessionCache?
  savedItineraries SavedItinerary[]
}

model InterestProfile {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  interests Json     @default("[]")
  updatedAt DateTime @updatedAt
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([tokenHash])
  @@index([userId])
}

model PlanSessionCache {
  id             String   @id @default(cuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  criteriaJson   Json
  itineraryJson  Json
  updatedAt      DateTime @updatedAt
  expiresAt      DateTime

  @@index([expiresAt])
}

model SavedItinerary {
  id          String                 @id @default(cuid())
  userId      String
  user        User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  destination String
  daysCount   Int
  coverUrl    String?
  snapshot    Json
  savedAt     DateTime               @default(now())
  messages    ItineraryChatMessage[]

  @@index([userId, savedAt])
}

model ItineraryChatMessage {
  id          String         @id @default(cuid())
  itineraryId String
  itinerary   SavedItinerary @relation(fields: [itineraryId], references: [id], onDelete: Cascade)
  role        String
  content     String
  ord         Int
  createdAt   DateTime       @default(now())

  @@index([itineraryId, ord])
}
