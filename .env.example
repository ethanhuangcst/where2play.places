# where2play — env template (no secrets). Same keys in .env.local and .env.production.
# Stack: ../../workspace-specs/3.tech-specs.md · ADR-033 · 2play-design.md §2.8
# Port registry: ../../workspace-specs/6.deployment-plan.md §0
#
# Local ports — do NOT reuse places-agent / what2eat PORT or PUBLIC_BASE_URL:
#   places-agent  PORT=3010  PUBLIC_BASE_URL=http://localhost:3010
#   what2eat      PORT=3020  PUBLIC_BASE_URL=http://localhost:3020
#   where2play    PORT=3030  PUBLIC_BASE_URL=http://localhost:3030
#
# Fill empty *KEY* / *SECRET* values yourself. Do not commit filled secrets.

# =============================================================================
# App runtime
# =============================================================================
APP_NAME=where2play
APP_ENV=local
# Do not set NODE_ENV here — Next.js sets it for dev/build/start.
PORT=3030

# =============================================================================
# Database (Prisma PostgreSQL — ADR-033)
# Local: share family Postgres on host 5435; `make db-bootstrap` creates DBs.
# Prod: Aliyun 101.132.156.250 — dedicated DB name `where2play` only.
# =============================================================================
DATABASE_URL=postgresql://where2play:where2play@localhost:5435/where2play
TEST_DATABASE_URL=postgresql://where2play:where2play@localhost:5435/where2play_test

# =============================================================================
# Session & public URLs
# =============================================================================
SESSION_SECRET=
PUBLIC_BASE_URL=http://localhost:3030
APP_URL=http://localhost:3030

# Next dev: comma-separated LAN IPs when testing from phone/laptop on same network
ALLOWED_DEV_ORIGINS=

# =============================================================================
# places-agent (BFF server-to-server — MVP-2+)
# HTTP /v1/* . Switch with PLACES_AGENT_TARGET. Issue caller keys in agent admin.
# Restart Next after changing PLACES_AGENT_TARGET.
# =============================================================================
PLACES_AGENT_TARGET=local

PLACES_AGENT_BASE_URL_LOCAL=http://localhost:3010
PLACES_AGENT_CALLER_KEY_LOCAL=

PLACES_AGENT_BASE_URL_PROD=https://places.agent-mate.ai
PLACES_AGENT_CALLER_KEY_PROD=

# Optional legacy fallback if per-target vars are unset
PLACES_AGENT_BASE_URL=http://localhost:3010
PLACES_AGENT_CALLER_KEY=
PLACES_AGENT_TIMEOUT_MS=25000

# Default providers[] when BFF does not infer from pin/locale (ADR-005)
W2P_DEFAULT_PROVIDERS=["GOOGLE_MAPS"]

# Chat / replan transcript truncate (chars)
CHAT_CONTEXT_MAX_CHARS=12000

# =============================================================================
# Email — Resend (password reset; MVP-1)
# =============================================================================
FEATURE_EMAIL=false
RESEND_API_KEY=
RESEND_HOST=api.resend.com
RESEND_BASE_URL=https://api.resend.com
RESEND_FROM_EMAIL=
RESEND_KEY_MGMT_SITE=https://resend.com/api-keys

# =============================================================================
# NOT used on where2play (do not add)
# OPENAI_*  AMAP_*  GOOGLE_MAPS_*  GMAPS_MCP_*  TRIPADVISOR_*  OPEN_METEO_*
# LLM + map vendors stay on places-agent (2play-design §2.1, ADR-033)
# =============================================================================
